# Dendrai agentic-tools environment.
# Copy to .env and fill in. None are required to start, but features unlock as set.

# PostgreSQL persistence. Unset = persistence disabled (app still runs).
# Railway: use the public proxy host (…proxy.rlwy.net:PORT) from outside Railway,
# or the internal host (postgres.railway.internal:5432) when deployed on Railway.
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Enables every AI-augmented endpoint (#1–#4): HITL gate recommendations,
# narrative analysis, persona briefs, audit report, and the investigation agent.
# Without it those routes return HTTP 503 and the deterministic pipeline is unaffected.
ANTHROPIC_API_KEY=

# Optional model override (defaults to claude-opus-4-8).
# DENDRAI_CLAUDE_MODEL=claude-opus-4-8

# Enables FRED macro leading-indicator correlations. Free key:
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional — hosted Dendrai MCP server URL for the Managed Agents deployment
# (managed_agent_setup.py). When set, the cloud agent calls real EDGAR/FRED tools
# instead of web search.
# DENDRAI_MCP_URL=https://your-host/mcp
