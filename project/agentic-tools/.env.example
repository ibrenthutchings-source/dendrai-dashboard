# Dendrai agentic-tools environment.
# Copy to .env and fill in. None are required to start, but features unlock as set.

# PostgreSQL persistence. Unset = persistence disabled (app still runs).
# Railway: use the public proxy host (…proxy.rlwy.net:PORT) from outside Railway,
# or the internal host (postgres.railway.internal:5432) when deployed on Railway.
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Enables every AI-augmented endpoint (#1–#4): HITL gate recommendations,
# narrative analysis, persona briefs, audit report, and the investigation agent.
# Without it those routes return HTTP 503 and the deterministic pipeline is unaffected.
ANTHROPIC_API_KEY=

# Optional model override (defaults to claude-opus-4-8).
# DENDRAI_CLAUDE_MODEL=claude-opus-4-8

# Enables FRED macro leading-indicator correlations. Free key:
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ── MCP guardrail settings ───────────────────────────────────────────────────
# Set to true/1 to block all DB writes and file-save operations across every
# MCP server (useful for demos, read-only analysis, or untrusted environments).
# MCP_READ_ONLY=false

# Override the default per-tool rate limit (calls per 60 s, default 30).
# Heavy tools (edgar_peer_financials, predictive_full_analysis) apply a tighter
# internal limit regardless of this setting.
# MCP_RATE_LIMIT_PER_MIN=30

# Optional — hosted Dendrai MCP server URL for the Managed Agents deployment
# (managed_agent_setup.py). When set, the cloud agent calls real EDGAR/FRED tools
# instead of web search.
# DENDRAI_MCP_URL=https://your-host/mcp

# ── Dendrai UBO Governance Brain ──────────────────────────────────────────────
# Slack-compatible webhook for ESCALATE verdict alerts (optional).
# If unset, alerts are suppressed silently.
# MCP_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Seconds between governance polling cycles (default 30).
# MCP_GOV_POLL_INTERVAL_S=30

# Telemetry rows processed per poll cycle (default 20).
# MCP_GOV_BATCH_SIZE=20

# ── MCP Telemetry Proxy ──────────────────────────────────────────────────────
# Comma-separated tool names that trigger a pre-execution hold.
# The proxy pauses forwarding and waits for operator approval before proceeding.
# Default list covers high-risk shell/database-mutation tools.
# PROXY_BLOCKING_TOOLS=shell,execute,bash,run_command,drop,truncate,delete_file,exec_sql

# Seconds to wait for operator approval before a hold expires (default 30).
# PROXY_HOLD_TIMEOUT_S=30

# Polling interval while waiting for hold resolution (default 1.0).
# PROXY_HOLD_POLL_S=1.0

# Rolling window (seconds) for high-frequency call detection (default 60).
# PROXY_FREQ_WINDOW_S=60

# Max calls within the window before high_frequency flag fires (default 10).
# PROXY_FREQ_THRESHOLD=10

# Seconds before a fire-and-forget DB write is silently cancelled (default 2.0).
# PROXY_WRITE_TIMEOUT_S=2.0

# Proxy log verbosity: DEBUG / INFO / WARNING (default WARNING).
# PROXY_LOG_LEVEL=WARNING

# ── Oracle Fusion Controls ───────────────────────────────────────────────────
# Enables /oracle-fusion/* REST endpoints and the oracle_fusion_mcp_server.py
# MCP tools (control library, test results, issues, SOD violations, audit events).
#
# Your Oracle Fusion Cloud pod hostname — no trailing slash.
ORACLE_FUSION_HOST=https://mycompany.fa.us6.oraclecloud.com

# Basic auth: service account with read access to RMCS + FSCM Audit + SCIM.
# Ignored when OAuth 2.0 client credentials are set below.
ORACLE_FUSION_USERNAME=
ORACLE_FUSION_PASSWORD=

# OAuth 2.0 Client Credentials — recommended for production.
# Create a Confidential Application in Oracle IDCS / Identity Domains.
# When set, these take priority over basic auth above.
ORACLE_FUSION_CLIENT_ID=
ORACLE_FUSION_CLIENT_SECRET=

# Optional: pin a specific REST API version (default 11.13.18.05).
# ORACLE_FUSION_API_VERSION=11.13.18.05
