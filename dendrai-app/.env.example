# Backend settings
GEMINI_API_KEY=your_google_generative_language_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Frontend proxy target for Vite dev server
VITE_API_BASE_URL=http://localhost:4000

# Clerk — get keys from https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# PostgreSQL — e.g. Neon: postgres://user:pass@host/db?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/dendrai
